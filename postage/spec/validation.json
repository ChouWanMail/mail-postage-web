{
  "schemaVersion": 7,
  "standardVersion": "1.5.0",
  "purpose": "定义 App、Web 或 CI 在读取邮资数据前应执行的跨文件一致性与交互状态检查。",
  "checks": [
    {"id":"DISPLAY-ONLY-NO-CHECKBOX","severity":"error","rule":"selection.mode=display-only 的项目不得渲染为复选框，不得进入寄件计算，且应排在可选项目之后。"},
    {"id":"DISPLAY-ONLY-ITEMS","severity":"error","rule":"国内存局候领、撤回/改址；国际/港澳台国际回信券、撤回/改址、进口欠资、存局候领、逾期保管、海关查验必须为 display-only。"},
    {"id":"DOMESTIC-POSTE-RESTANTE-NOT-PARCEL","severity":"error","rule":"国内存局候领不得适用于普通包裹或家乡包裹贴。"},
    {"id":"LETTER-INSURANCE-MAILTYPE","severity":"error","rule":"国内、国际和港澳台函件保价仅适用于 LETTER。"},
    {"id":"LETTER-INSURANCE-MAX","severity":"error","rule":"函件保价 maximumInsuredValue=20000。"},
    {"id":"DOMESTIC-PARCEL-INSURANCE","severity":"error","rule":"DOMESTIC_PARCEL_INSURANCE_FEE 使用 declared_value_percentage，percentage=0.01，maximumInsuredValue=100000。"},
    {"id":"INTL-HMT-INSURANCE-REQUIRES-HANDLING","severity":"error","rule":"国际/港澳台保价费自动依赖保价函件手续费。"},
    {"id":"INTL-HMT-HANDLING-REPLACES-REGISTRATION","severity":"error","rule":"保价函件手续费包含并替代独立挂号费。"},
    {"id":"ADVICE-REQUIRES-REGISTRATION-OR-HANDLING","severity":"error","rule":"国际/港澳台回执由挂号费或保价函件手续费满足挂号前提。"},
    {"id":"CASCADE-UNSELECT","severity":"error","rule":"取消依赖项时必须反向级联取消所有失去满足条件的依赖业务。"},
    {"id":"ORDINARY-PARCEL-ADVICE","severity":"error","rule":"普通包裹回执不额外收挂号费。"},
    {"id":"HOMETOWN-NO-ADVICE","severity":"error","rule":"家乡包裹贴可保价但不可回执。"},
    {"id":"DISCOUNT-BASE-ONLY","severity":"error","rule":"普通包裹8折/7折只作用于基础寄递资费，保价/回执等 special 费用不得折扣。"},
    {"id":"TAIWAN-ADVICE-UNAVAILABLE","severity":"error","rule":"台湾回执保持不可用。"}
  ]
}
