{
  "schemaVersion": 7,
  "standardVersion": "1.5.0",
  "currency": "CNY",
  "defaultWeightUnit": "g",
  "roundingValues": {"ceil":"不足一个计费单位按一个完整计费单位计算。"},
  "supportedTypes": {
    "flat":{"required":["price"],"formula":"total = price"},
    "flat_by_locality":{"required":["prices"],"formula":"total = prices[locality]"},
    "free":{"required":["price"],"formula":"total = 0"},
    "base_plus_increment":{"required":["baseWeight","basePrice","incrementWeight","incrementPrice","rounding"],"formula":"weight <= baseWeight ? basePrice : basePrice + ceil((weight-baseWeight)/incrementWeight)*incrementPrice"},
    "surcharge_per_increment":{"required":["incrementWeight","incrementPrice","rounding"],"formula":"ceil(weight/incrementWeight)*incrementPrice"},
    "air_surcharge_only":{"required":["basicPostageExempt","incrementWeight","rounding"],"formula":"ceil(weight/incrementWeight)*zones[zoneId].incrementPrice"},
    "weight_tiers":{"required":["tiers"],"formula":"选择唯一满足上下界的 tier，total=tier.price。"},
    "tiered_incremental":{"required":["tiers","rounding"],"formula":"各阶段按实际覆盖重量向上取整后累计。"},
    "weight_band_base_plus_increment_by_route":{"status":"legacy-compatible"},
    "weight_band_base_plus_increment_by_route_group":{"requiredTopLevel":["weightBands","originFiles","regionRegistry"]},
    "multiplier":{"required":["multiplier"],"formula":"discountedTotal = originalTotal * multiplier"},
    "value_increment":{"required":["valueIncrement","incrementPrice","rounding"],"optional":["maximumInsuredValue"],"formula":"ceil(declaredValue/valueIncrement)*incrementPrice"},
    "value_increment_with_minimum":{"required":["valueIncrement","incrementPrice","rounding","minimumPrice"],"optional":["maximumInsuredValue"],"formula":"max(minimumPrice,ceil(declaredValue/valueIncrement)*incrementPrice)"},
    "declared_value_percentage":{"required":["percentage"],"optional":["maximumInsuredValue","minimumPrice"],"formula":"raw = declaredValue * percentage; total = minimumPrice == null ? raw : max(minimumPrice, raw)"},
    "external_rule":{"required":["ruleRefZh"],"formula":null}
  },
  "insuranceRules": {
    "domesticLetter":"只允许 LETTER，最高20000元。",
    "domesticParcel":"DOMESTIC_PARCEL_INSURANCE_FEE percentage=0.01，最高100000元。",
    "internationalAndHmtLetter":"只允许 LETTER，最高20000元，并要求 INSURED_LETTER_HANDLING_FEE。"
  },
  "ordinaryParcelVolumetricWeight":{"divisor":6000,"dimensionUnit":"cm","resultUnit":"kg","formula":"lengthCm * widthCm * heightCm / 6000"}
}
